<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__brand">
      <img src="/img/coasthr-logo-stacked.png" alt="CoastHR" style="height:56px; width:auto;">
      <p>Small Business HR. Simplified.</p>
    </div>
    <div class="site-footer__contact">
      <p><a href="tel:{{ site.phone }}">{{ site.phone }}</a></p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p>
        <a href="{{ site.linkedin }}" target="_blank" rel="nofollow noopener">
          <img src="/img/linkedin-icon.png" alt="LinkedIn" style="height:28px; width:auto;">
        </a>
      </p>
    </div>
    <div class="site-footer__legal">
      <p>&copy; {{ site.currentYear }} Coast HR</p>
      <p><a href="/privacy-policy/">Privacy Policy</a></p>
    </div>
  </div>
</footer>
